# Optional: override the default ~/.mkagent configuration root.
# MKAGENT_CONFIG_DIR=/absolute/path/to/mkagent-data

# Optional: enable application debug logging.
# MKAGENT_DEBUG=true

# Optional: Sentry error tracking. Sentry is disabled when this is unset.
# SENTRY_ELECTRON_INGEST_URL=https://your-public-key@o0.ingest.sentry.io/0
