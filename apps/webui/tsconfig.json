{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["../electron/src/renderer/*"],
      "@webui/*": ["./src/*"],
      "@config/*": ["../../packages/shared/src/config/*"],
      "@mkagent/shared": ["../../packages/shared/src/index.ts"],
      "@mkagent/shared/*": ["../../packages/shared/src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../electron/src/renderer/App.tsx",
    "../electron/src/shared/types.ts",
    "../electron/src/transport/client.ts",
    "../electron/src/transport/build-api.ts",
    "../electron/src/transport/channel-map.ts",
    "../../packages/shared/src/**/*.d.ts",
    "../../packages/ui/src/pdfjs-worker.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
