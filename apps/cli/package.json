{
  "name": "@mkagent/cli",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Terminal client for MkAgent server",
  "type": "module",
  "main": "dist/mkagent",
  "files": [
    "dist/mkagent"
  ],
  "bin": {
    "mkagent": "dist/mkagent"
  },
  "scripts": {
    "build": "mkdir -p dist && bun build src/index.ts --target=bun --outfile=dist/mkagent",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/"
  },
  "dependencies": {
    "@mkagent/shared": "workspace:*",
    "@mkagent/server-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "@types/bun": "latest"
  }
}
